# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=sqlite:///./credit_v3.db
APP_PASSWORD=
ANALYST_PASSWORD=
# Optional JSON mapping username -> {role, password_hash}. Overrides shared accounts.
# Generate hashes with python scripts/password_hash.py
APP_USERS_JSON=
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
